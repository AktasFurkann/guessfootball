# MongoDB Atlas
MONGODB_URI=mongodb+srv://<kullanici>:<parola>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=football_db

# HTTP sunucusu
PORT=3000

# Transfermarkt veri dili (tr | en)
TM_LOCALE=tr

# Istekler arasi bekleme araligi (ms) - IP engelini onlemek icin
TM_DELAY_MIN_MS=1500
TM_DELAY_MAX_MS=2000
